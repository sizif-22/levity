<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>AntigravitySidebar</RootNamespace>
    <AssemblyName>Levity</AssemblyName>
    <Product>Levity</Product>
    <Description>Levity - desktop and mobile control surface for the Antigravity CLI</Description>
  </PropertyGroup>

  <!-- Other projects in this repo (tests, phone app, relay) are not part of the desktop app. -->
  <ItemGroup>
    <Compile Remove="tests\**;web\**;relay\**;publish\**" />
    <EmbeddedResource Remove="tests\**;web\**;relay\**;publish\**" />
    <None Remove="tests\**;web\**;relay\**;publish\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include=".env.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
