# Levity configuration. Copy this file to ".env" and edit it.
#
#   copy .env.example .env
#
# Levity reads ".env" at start-up from, in order: the file named by LEVITY_ENV_FILE,
# the folder that contains Levity.exe, then %APPDATA%\Levity.
# A variable already set in your shell always wins over the file. Empty values are ignored.
#
# These are FIRST-RUN DEFAULTS. Anything you change inside the app (relay address,
# phone app address, projects folder, ...) is saved in settings.json and wins afterwards.
# Pairing keys are never stored here: they are generated per phone and encrypted
# with Windows DPAPI in settings.json.

# --- Phone access (optional) -------------------------------------------------------------
# Address of your relay (a Cloudflare Worker you deploy from ./relay). Use wss://
LEVITY_RELAY_URL=
# Address where you host the phone app (the ./web build), e.g. https://levity.example.com
LEVITY_APP_URL=

# --- Projects -----------------------------------------------------------------------------
# Folder scanned for projects in the Projects panel. Default: your user folder.
LEVITY_PROJECTS_ROOT=

# --- Tools --------------------------------------------------------------------------------
# Full path to agy.exe if it is not in %LOCALAPPDATA%\agy\bin or on PATH.
AGY_PATH=
# Full path to antigravity.cmd for "Open in Antigravity IDE".
ANTIGRAVITY_IDE_PATH=

# --- Architecture diagram ---------------------------------------------------------------
# How hard the assistant thinks when drawing a diagram: low (default), medium or high. Higher costs more tokens.
LEVITY_DIAGRAM_EFFORT=
# Seconds to wait for the assistant to answer before giving up (30 to 1800, default 300).
LEVITY_DIAGRAM_TIMEOUT=

# --- App ----------------------------------------------------------------------------------
# Sidebar width in pixels (default 460).
LEVITY_SIDEBAR_WIDTH=
# Minutes without any message before the assistant process is stopped to free about 100 MB (default 10).
# The next message starts it again and resumes the same conversation. 0 keeps it running (a little faster first message).
LEVITY_AGENT_IDLE_MINUTES=
# Same in seconds. For testing only; it wins over the minutes setting.
LEVITY_AGENT_IDLE_SECONDS=
# Minutes the sidebar may stay hidden before its web view is thrown away completely to free about 25 MB more (default 30, 0 = never).
# Opening the sidebar again rebuilds the page from your conversation in under a second.
LEVITY_WEBVIEW_RELEASE_MINUTES=
# Same in seconds. For testing only; it wins over the minutes setting.
LEVITY_WEBVIEW_RELEASE_SECONDS=
# Set to 1 to write every message and event of the assistant to debug.log next to Levity.exe (for bug reports only; it contains your conversations).
LEVITY_DEBUG_LOG=
# Where settings.json, chat sessions and the WebView cache live. Default: %APPDATA%\Levity
LEVITY_SETTINGS_DIR=
# Skills folder used by Install-Skills.ps1. Default: %USERPROFILE%\.gemini\config\skills
LEVITY_SKILLS_DIR=
